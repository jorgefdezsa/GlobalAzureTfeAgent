<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GlobalDemo.ServiceDefaults\GlobalDemo.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- OPENAI001: OpenAIClient con AuthenticationPolicy (Entra ID) aún es experimental en el SDK.
         EXTEXP0001: RemoveAllResilienceHandlers (timeouts propios hacia el MCP) aún es experimental. -->
    <NoWarn>$(NoWarn);OPENAI001;EXTEXP0001</NoWarn>
  </PropertyGroup>

</Project>
